{
  "name": "untrick-site",
  "version": "0.1.0",
  "private": true,
  "description": "Landing page for the free consumer-law scan at untrick.eu.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "linkinator dist --recurse --skip \"^https?://(?!localhost|127\\\\.0\\\\.0\\\\.1)\"",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check": "npm run check:content && npm run build && npm run check:html && npm run check:links && npm run check:a11y",
    "serve": "npx --yes serve dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "html-validate": "^11.22.1",
    "linkinator": "^8.1.0",
    "playwright": "^1.65.1"
  }
}
